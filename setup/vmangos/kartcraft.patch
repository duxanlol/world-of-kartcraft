+
+    struct Race
+    {
+        Course const* course = nullptr;
+        ObjectGuid host;
+        uint32 created = 0;
+        uint32 start = 0; // 0 until started
+        // When a warp orb was last rolled in the race (ms), for WARP_COOLDOWN; 0 none yet.
+        uint32 warpRolled = 0;
+        uint8 finishers = 0;
+        // When the first racer finished (ms), for the rest's DNF_WAIT; 0 none yet.
