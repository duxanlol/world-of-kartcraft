+    // "1:02.40", as the client shows a race time.
+    static std::string Clock(uint32 ms)
+    {
+        char buf[32];
+        std::snprintf(buf, sizeof(buf), "%u:%02u.%02u", ms / 60000, ms / 1000 % 60, ms % 1000 / 10);
+        return buf;
+    }
