+        uint32 at;
+        bool hit = false;
+        bool dropped = false;
+        bool juiced = false;
+        float x = 0.f, y = 0.f;
+        bool shieldBomb = false;
+        uint8 breaks = 0; // crates it has broken (SHOT_BREAKS)
