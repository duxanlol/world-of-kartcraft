+    static Good const* FindGood(std::string const& key)
+    {
+        for (Good const& g : GOODS)
+            if (key == g.key)
+                return &g;
+        return nullptr;
+    }
+
+    // A flag's or a horn's wire index (the client's FLAGS or HORNS: that kind in GOODS' order,
+    // from 1); 0 none.
+    static uint32 KindIndex(char kind, std::string const& key)
+    {
+        uint32 i = 0;
+        for (Good const& g : GOODS)
+            if (g.kind == kind)
+            {
+                ++i;
+                if (key == g.key)
+                    return i;
+            }
+        return 0;
+    }
+
+    static uint32 FlagIndex(std::string const& key)
+    {
+        return KindIndex('F', key);
+    }
